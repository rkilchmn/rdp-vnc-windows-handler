{
  "MstscPath": "",

  "VncViewerPath": "",
  "VncViewerArgs": "{hostport}",
  "VncDefaultPort": 5900,

  "ScreenModeId": 2,
  "DesktopWidth": 1280,
  "DesktopHeight": 800,
  "UseMultiMon": 0,
  "SessionBpp": 32,

